# Firebase Configuration
# Las claves de Firebase están diseñadas para ser públicas, pero en este proyecto
# Firebase solo se usa en el servidor (Server Actions), por lo que se mantienen
# como variables privadas como medida de seguridad adicional.
FIREBASE_API_KEY="AIzaSy...YOUR_KEY..."
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"

# Maileroo API Key
# ¡IMPORTANTE! Esta clave es secreta y NUNCA debe ser expuesta en el lado del cliente.
# Solo debe ser usada en el backend (ej. API Routes de Next.js).
MAILEROO_API_KEY="your-secret-maileroo-api-key"
MAILEROO_FROM_EMAIL="your_verified_from_email"
MAILEROO_TO_CONTACT="your_contact_form_recipient_email"

# SEO Configuration
SITE_URL="http://localhost:9002"
WHATSAPP_NUMBER="521234567890"
INSTAGRAM_URL="https://instagram.com/userIG"